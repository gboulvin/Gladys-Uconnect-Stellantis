    {
      "key": "email",
      "type": "string",
      "label": {
        "en": "E-mail",
        "fr": "E-mail",
        "de": "E-Mail",
        "es": "Correo electrónico"
      },
      "placeholder": {
        "en": "you@example.com",
        "fr": "vous@exemple.fr",
        "de": "sie@beispiel.de",
        "es": "usted@ejemplo.es"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": true
    },
    {
      "key": "pin",
      "type": "secret",
      "label": {
        "en": "PIN (commands)",
        "fr": "Code PIN (commandes)",
        "de": "PIN (Befehle)",
        "es": "PIN (comandos)"
      },
      "description": {
        "en": "The 4-digit PIN of the app, needed to lock, unlock, start the climate or the charge. Leave empty for read-only use.",
        "fr": "Le code PIN à 4 chiffres de l’application, nécessaire pour verrouiller, déverrouiller, lancer la climatisation ou la recharge. Laissez vide pour une utilisation en lecture seule.",
        "de": "Die 4-stellige PIN der App, nötig zum Verriegeln, Entriegeln, Starten von Klimatisierung oder Laden. Leer lassen für reinen Lesezugriff.",
        "es": "El PIN de 4 dígitos de la aplicación, necesario para bloquear, desbloquear, encender la climatización o la carga. Déjelo vacío para un uso de solo lectura."
      },
      "placeholder": {
        "en": "e.g. 1234",
        "fr": "ex. 1234",
        "de": "z. B. 1234",
        "es": "p. ej. 1234"
      },
      "required": false
    },
    {
      "key": "refresh_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (min)",
        "fr": "Intervalle de rafraîchissement (min)",
        "de": "Aktualisierungsintervall (Min.)",
        "es": "Intervalo de actualización (min)"
      },
      "description": {
        "en": "How often the Uconnect cloud is read. The vehicle itself uploads its state at its own pace.",
        "fr": "Fréquence de lecture du cloud Uconnect. Le véhicule envoie lui-même son état à son propre rythme.",
        "de": "Wie oft die Uconnect-Cloud gelesen wird. Das Fahrzeug lädt seinen Zustand in seinem eigenen Rhythmus hoch.",
        "es": "Frecuencia de lectura de la nube Uconnect. El vehículo envía su estado a su propio ritmo."
      },
      "required": false,
      "default": 5,
      "min": 2,
      "max": 240
    },
    {
      "key": "low_battery_threshold",
      "type": "number",
      "label": {
        "en": "Low battery threshold (%)",
        "fr": "Seuil de batterie faible (%)",
        "de": "Schwelle niedriger Akkustand (%)",
        "es": "Umbral de batería baja (%)"
      },
      "description": {
        "en": "The \"Battery low\" scene trigger fires when the charge drops under this level.",
        "fr": "Le déclencheur de scène « Batterie faible » se déclenche quand la charge passe sous ce niveau.",
        "de": "Der Szenen-Auslöser „Akku niedrig“ wird ausgelöst, wenn die Ladung unter diesen Wert fällt.",
        "es": "El disparador de escena «Batería baja» se activa cuando la carga baja de este nivel."
      },
      "required": false,
      "default": 20,
      "min": 0,
      "max": 100
    },
    {
      "key": "temperature_unit",
      "type": "select",
      "label": {
        "en": "Climate temperature unit",
        "fr": "Unité de température de la climatisation",
        "de": "Temperatureinheit der Klimatisierung",
        "es": "Unidad de temperatura de la climatización"
      },
      "required": false,
      "default": "celsius",
      "options": [
        {
          "value": "celsius",
          "label": {
            "en": "Celsius",
            "fr": "Celsius",
            "de": "Celsius",
            "es": "Celsius"
          }
        },
        {
          "value": "fahrenheit",
          "label": {
            "en": "Fahrenheit",
            "fr": "Fahrenheit",
            "de": "Fahrenheit",
            "es": "Fahrenheit"
          }
        }
      ]
    },
    {
      "key": "climate_temperature",
      "type": "number",
      "label": {
        "en": "Default climate temperature",
        "fr": "Température de climatisation par défaut",
        "de": "Standard-Klimatemperatur",
        "es": "Temperatura de climatización por defecto"
      },
      "description": {
        "en": "Target sent with \"Start the climate\", for the vehicles that accept one.",
        "fr": "Consigne envoyée avec « Démarrer la climatisation », pour les véhicules qui l’acceptent.",
        "de": "Zielwert, der mit „Klimatisierung starten“ gesendet wird, sofern das Fahrzeug ihn unterstützt.",
        "es": "Temperatura enviada con «Encender la climatización», en los vehículos que la admiten."
      },
      "required": false,
      "default": 21,
      "min": 10,
      "max": 90
    },
    {
      "key": "wait_for_confirmation",
      "type": "boolean",
      "label": {
        "en": "Wait for the vehicle to confirm commands",
        "fr": "Attendre la confirmation du véhicule",
        "de": "Auf Bestätigung des Fahrzeugs warten",
        "es": "Esperar la confirmación del vehículo"
      },
      "description": {
        "en": "Scene actions and widget buttons wait (up to 75 s) for the vehicle to report the result.",
        "fr": "Les actions de scène et les boutons du widget attendent (jusqu’à 75 s) le résultat renvoyé par le véhicule.",
        "de": "Szenenaktionen und Widget-Schaltflächen warten (bis zu 75 s) auf das Ergebnis des Fahrzeugs.",
        "es": "Las acciones de escena y los botones del widget esperan (hasta 75 s) el resultado del vehículo."
      },
      "required": false,
      "default": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Log in to Uconnect and list the vehicles of the account.",
        "fr": "Se connecte à Uconnect et liste les véhicules du compte.",
        "de": "Meldet sich bei Uconnect an und listet die Fahrzeuge des Kontos auf.",
        "es": "Inicia sesión en Uconnect y muestra los vehículos de la cuenta."
      },
      "timeout_seconds": 60
    },
    {
      "key": "refresh",
